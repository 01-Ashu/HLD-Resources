### STEP 3 — ParkingSpot Hierarchy

```java
public abstract class ParkingSpot {
    private String      spotId;
    private SpotType    spotType;
    private SpotStatus  status;
    private Vehicle     currentVehicle;

    public ParkingSpot(String spotId, SpotType spotType) {
        this.spotId   = spotId;
        this.spotType = spotType;
        this.status   = SpotStatus.AVAILABLE;
    }

    public boolean isAvailable() {
        return status == SpotStatus.AVAILABLE;
    }

    // synchronized — two vehicles can't grab same spot
    public synchronized void assignVehicle(Vehicle vehicle) {
        if (!isAvailable()) {
            throw new RuntimeException("Spot already occupied!");
        }
        this.currentVehicle = vehicle;
        this.status         = SpotStatus.OCCUPIED;
    }

    public synchronized void removeVehicle() {
        this.currentVehicle = null;
        this.status         = SpotStatus.AVAILABLE;
    }

    public abstract boolean canFitVehicle(Vehicle vehicle);

    public String   getSpotId()   { return spotId;   }
    public SpotType getSpotType() { return spotType;  }
}

// Small — fits Bike only
public class SmallSpot extends ParkingSpot {
    public SmallSpot(String spotId) {
        super(spotId, SpotType.SMALL);
    }
    @Override
    public boolean canFitVehicle(Vehicle v) {
        return v.getVehicleType() == VehicleType.BIKE;
    }
}

// Medium — fits Car only
public class MediumSpot extends ParkingSpot {
    public MediumSpot(String spotId) {
        super(spotId, SpotType.MEDIUM);
    }
    @Override
    public boolean canFitVehicle(Vehicle v) {
        return v.getVehicleType() == VehicleType.CAR;
    }
}

// Large — fits Truck only
public class LargeSpot extends ParkingSpot {
    public LargeSpot(String spotId) {
        super(spotId, SpotType.LARGE);
    }
    @Override
    public boolean canFitVehicle(Vehicle v) {
        return v.getVehicleType() == VehicleType.TRUCK;
    }
}
