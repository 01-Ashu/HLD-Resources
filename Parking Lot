// Concrete observer
public class DisplayBoard implements Observer {

    @Override
    public void update(List<ParkingFloor> floors) {
        System.out.println("===== DISPLAY BOARD =====");
        for (ParkingFloor floor : floors) {
            long available = floor.getSpots()
                .stream()
                .filter(ParkingSpot::isAvailable)
                .count();
            System.out.println("Floor " + floor.getFloorId()
                + " → Available: " + available);
        }
        System.out.println("=========================");
    }
}
