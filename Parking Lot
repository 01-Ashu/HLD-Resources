```java
public class Main {
    public static void main(String[] args) {

        // 1. Setup parking lot (Singleton)
        ParkingLot lot = ParkingLot.getInstance("Phoenix Mall");

        // 2. Create floors
        ParkingFloor floor1 = new ParkingFloor("F1");
        ParkingFloor floor2 = new ParkingFloor("F2");

        // 3. Add spots using SpotFactory
        floor1.addSpot(SpotFactory.createSpot(VehicleType.BIKE,  "F1-S1"));
        floor1.addSpot(SpotFactory.createSpot(VehicleType.CAR,   "F1-S2"));
        floor1.addSpot(SpotFactory.createSpot(VehicleType.CAR,   "F1-S3"));
        floor2.addSpot(SpotFactory.createSpot(VehicleType.TRUCK, "F2-S1"));

        lot.addFloor(floor1);
        lot.addFloor(floor2);

        // 4. Setup gates
        EntryGate entry = new EntryGate("GATE-1", lot);
        ExitGate  exit  = new ExitGate(
            "GATE-2",
            new HourlyPricing(),  // pricing strategy
            new UPIPayment()      // payment strategy
        );

        // 5. Vehicle enters
        Vehicle car = new Car("MH-01-AB-1234");
        Ticket ticket = entry.entry(car);

        // 6. Switch payment to cash at runtime
        exit.setPaymentStrategy(new CashPayment());

        // 7. Vehicle exits
        exit.exit(ticket);
    }
}
```

