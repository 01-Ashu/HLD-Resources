### STEP 12 — ExitGate

```java
public class ExitGate {
    private String          gateId;
    private PricingStrategy pricingStrategy;
    private PaymentStrategy paymentStrategy;

    public ExitGate(String gateId,
                    PricingStrategy pricing,
                    PaymentStrategy payment) {
        this.gateId          = gateId;
        this.pricingStrategy = pricing;
        this.paymentStrategy = payment;
    }

    public void exit(Ticket ticket) {

        // 1. Calculate hours parked
        LocalDateTime exitTime = LocalDateTime.now();
        long hours = ChronoUnit.HOURS.between(
            ticket.getEntryTime(), exitTime);

        // Minimum 1 hour billing
        hours = Math.max(hours, 1);

        // 2. Calculate fare — Strategy pattern
        double fare = pricingStrategy.calculateFare(
            hours,
            ticket.getVehicle().getVehicleType());

        // 3. Process payment — Strategy pattern
        paymentStrategy.processPayment(fare);

        // 4. Free the spot
        ticket.getSpot().removeVehicle();

        // 5. Update display board
        System.out.println("Exit done. Spot freed: "
            + ticket.getSpot().getSpotId()
            + " | Fare: ₹" + fare);
    }

    // Switch payment at runtime — Strategy!
    public void setPaymentStrategy(PaymentStrategy p) {
        this.paymentStrategy = p;
    }

    // Switch pricing at runtime — Strategy!
    public void setPricingStrategy(PricingStrategy p) {
        this.pricingStrategy = p;
    }
}
```

