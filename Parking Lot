### STEP 4 — ParkingFloor

```java
public class ParkingFloor {
    private String            floorId;
    private List<ParkingSpot> spots;

    public ParkingFloor(String floorId) {
        this.floorId = floorId;
        this.spots   = new ArrayList<>();
    }

    public void addSpot(ParkingSpot spot) {
        spots.add(spot);
    }

    // synchronized — two threads can't scan
    // same floor simultaneously
    public synchronized ParkingSpot findAvailableSpot(Vehicle v) {
        for (ParkingSpot spot : spots) {
            if (spot.isAvailable() && spot.canFitVehicle(v)) {
                return spot;
            }
        }
        return null;
    }

    public int getAvailableCount(VehicleType type) {
        int count = 0;
        for (ParkingSpot spot : spots) {
            if (spot.isAvailable()) {
                // create dummy vehicle to check fit
                Vehicle dummy = createDummy(type);
                if (spot.canFitVehicle(dummy)) count++;
            }
        }
        return count;
    }

    private Vehicle createDummy(VehicleType type) {
        switch (type) {
            case BIKE:  return new Bike("DUMMY");
            case CAR:   return new Car("DUMMY");
            case TRUCK: return new Truck("DUMMY");
            default: throw new IllegalArgumentException();
        }
    }

    public String            getFloorId() { return floorId; }
    public List<ParkingSpot> getSpots()   { return spots;   }
}
```

