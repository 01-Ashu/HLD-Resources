PART 5 — Correct Way to Use Prototype in Spring
❌ Wrong — Prototype injected into Singleton
@Service
public class PaymentService {

    @Autowired
    private PaymentReceiptGenerator generator;
    // Spring injects this ONCE at startup
    // Same instance reused forever → acts like Singleton 🚫
    // @Scope("prototype") has NO EFFECT here!
}
✅ Correct — Get fresh instance via ApplicationContext
@Service
public class PaymentService {

    @Autowired
    private ApplicationContext context; // inject Spring container itself

    public void processPayment(String userId, double amount, String txnId) {
        // Fresh NEW instance every single time ✅
        PaymentReceiptGenerator generator =
            context.getBean(PaymentReceiptGenerator.class);

        generator.setDetails(userId, amount, txnId);
        String receipt = generator.generateReceipt();
        System.out.println(receipt);
    }
}

