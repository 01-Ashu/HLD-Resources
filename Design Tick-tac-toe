//
//  Pattern          │ Where used
//  ─────────────────┼──────────────────────────────────────────
//  Abstract Class   │ Player — shared name+symbol state
//  Strategy         │ WinningStrategy — Row/Col/Diagonal
//  Observer         │ Game (Subject) → DisplayBoard,
//                   │   Leaderboard, Notification (Observers)
//  Factory          │ PlayerFactory — creates Human or Bot
//  ─────────────────┼──────────────────────────────────────────
//
//  JPA INHERITANCE (for real projects)
//  ─────────────────────────────────────────────────────────────
//  @Entity
//  @Inheritance(strategy = InheritanceType.JOINED)
//  abstract class Player → TABLE: player (id, name, symbol)
//
//  @Entity HumanPlayer  → TABLE: human_player (id FK, input_source)
//  @Entity BotPlayer    → TABLE: bot_player   (id FK, difficulty)
//
//  Hibernate JOINs automatically. No NULL columns. Fully normalized.
// ─────────────────────────────────────────────────────────────
